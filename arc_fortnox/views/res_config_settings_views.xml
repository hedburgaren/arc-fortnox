<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.arc_fortnox</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Fortnox" string="Fortnox" name="arc_fortnox" groups="base.group_system">
                    <block title="Connection" name="arc_fortnox_connection_container">
                        <setting id="arc_fortnox_client_credentials" string="Client Credentials" company_dependent="1" help="Client id and client secret from your own app registration in the Fortnox developer portal. Left empty, the parameters arc_fortnox.client_id and arc_fortnox.client_secret from the server configuration are used instead.">
                            <div class="row">
                                <label for="arc_fortnox_client_id" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_client_id"/>
                            </div>
                            <div class="row">
                                <label for="arc_fortnox_client_secret" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_client_secret" password="True"/>
                            </div>
                            <div class="row">
                                <label for="arc_fortnox_redirect_uri" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_redirect_uri" readonly="1" class="w-50"/>
                            </div>
                            <div class="row mt8">
                                <button name="action_arc_fortnox_authorize" string="Authorize with Fortnox" type="object" class="btn-primary" icon="fa-plug"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Invoicing Trigger" name="arc_fortnox_trigger_container">
                        <setting id="arc_fortnox_trigger_mode" string="Trigger Mode" company_dependent="1" help="Manual only: orders are queued from the button on the order. Automatic on order domain: the cron also queues confirmed orders matching the trigger domain.">
                            <field name="arc_fortnox_trigger_mode" class="w-50"/>
                            <div class="row mt8" invisible="arc_fortnox_trigger_mode != 'domain'">
                                <label for="arc_fortnox_trigger_domain" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_trigger_domain" class="w-50" placeholder="[('state', '=', 'sale')]"/>
                            </div>
                        </setting>
                    </block>
                    <block title="API and Retries" name="arc_fortnox_api_container">
                        <setting id="arc_fortnox_throttle" string="Rate Limit" company_dependent="1" help="Maximum Fortnox API calls per throttle period.">
                            <div class="row">
                                <label for="arc_fortnox_throttle_calls" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_throttle_calls"/>
                            </div>
                            <div class="row">
                                <label for="arc_fortnox_throttle_seconds" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_throttle_seconds"/>
                            </div>
                        </setting>
                        <setting id="arc_fortnox_timeouts" string="Timeouts" company_dependent="1" help="Connection and response timeouts in seconds.">
                            <div class="row">
                                <label for="arc_fortnox_timeout_connect" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_timeout_connect"/>
                            </div>
                            <div class="row">
                                <label for="arc_fortnox_timeout_read" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_timeout_read"/>
                            </div>
                        </setting>
                        <setting id="arc_fortnox_retries" string="Retries" company_dependent="1" help="Backoff schedule in minutes between attempts, and the attempt number at which a queue entry becomes a hard error.">
                            <div class="row">
                                <label for="arc_fortnox_backoff_minutes" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_backoff_minutes"/>
                            </div>
                            <div class="row">
                                <label for="arc_fortnox_max_attempts" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_max_attempts"/>
                            </div>
                        </setting>
                        <setting id="arc_fortnox_rows" string="Invoice Rows" company_dependent="1" help="Row behavior when pushing an order to Fortnox.">
                            <div class="row">
                                <label for="arc_fortnox_max_description_length" class="col-lg-3 o_light_label"/>
                                <field name="arc_fortnox_max_description_length"/>
                            </div>
                            <div class="row">
                                <field name="arc_fortnox_send_article_numbers"/>
                                <label for="arc_fortnox_send_article_numbers"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
