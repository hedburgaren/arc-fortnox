<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_term_form_inherit_arc_fortnox" model="ir.ui.view">
        <field name="name">account.payment.term.form.inherit.arc_fortnox</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//group)[1]" position="inside">
                <field name="arc_fortnox_code"/>
            </xpath>
        </field>
    </record>

    <record id="product_uom_form_view_inherit_arc_fortnox" model="ir.ui.view">
        <field name="name">uom.uom.form.inherit.arc_fortnox</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='uom_details']//field[@name='category_id']" position="after">
                <field name="arc_fortnox_unit"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_inherit_arc_fortnox" model="ir.ui.view">
        <field name="name">product.template.form.inherit.arc_fortnox</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[@name='group_general']" position="inside">
                <field name="arc_fortnox_article"/>
                <field name="arc_fortnox_account"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_inherit_arc_fortnox" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.arc_fortnox</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="arc_fortnox_customer_number" groups="arc_fortnox.group_invoicer"
                       invisible="parent_id"/>
            </xpath>
        </field>
    </record>
</odoo>
