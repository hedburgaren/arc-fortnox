<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_process_queue" model="ir.cron">
        <field name="name">Fortnox: process invoice queue</field>
        <field name="model_id" ref="model_arc_fortnox_queue"/>
        <field name="state">code</field>
        <field name="code">model._arc_fortnox_cron_process()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_auto_enqueue" model="ir.cron">
        <field name="name">Fortnox: enqueue orders from trigger domain</field>
        <field name="model_id" ref="model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._arc_fortnox_cron_auto_enqueue()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_warn_expiry" model="ir.cron">
        <field name="name">Fortnox: warn about authorization expiry</field>
        <field name="model_id" ref="model_arc_fortnox_credential"/>
        <field name="state">code</field>
        <field name="code">model._arc_fortnox_cron_warn_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
