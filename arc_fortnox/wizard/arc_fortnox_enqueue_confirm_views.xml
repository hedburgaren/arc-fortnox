<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arc_fortnox_enqueue_confirm_form" model="ir.ui.view">
        <field name="name">arc.fortnox.enqueue.confirm.form</field>
        <field name="model">arc.fortnox.enqueue.confirm</field>
        <field name="arch" type="xml">
            <form string="Queue for Fortnox?">
                <field name="warning_text" nolabel="1"/>
                <footer>
                    <button name="action_confirm" string="Queue anyway" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
