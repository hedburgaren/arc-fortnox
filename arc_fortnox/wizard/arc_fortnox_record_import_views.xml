<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arc_fortnox_record_import_form" model="ir.ui.view">
        <field name="name">arc.fortnox.record.import.form</field>
        <field name="model">arc.fortnox.record.import</field>
        <field name="arch" type="xml">
            <form string="Import Fortnox Export">
                <group>
                    <field name="record_type"/>
                    <field name="file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_arc_fortnox_record_import" model="ir.actions.act_window">
        <field name="name">Import Fortnox Export</field>
        <field name="res_model">arc.fortnox.record.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
